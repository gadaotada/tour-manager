{
  "name": "tour-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "generate:client-version": "node scripts/generate-client-version.mjs",
    "ensure:client-version": "node scripts/generate-client-version.mjs --ensure",
    "predev": "npm run ensure:client-version",
    "predev:client": "npm run ensure:client-version",
    "predev:server": "npm run ensure:client-version",
    "prebuild": "npm run generate:client-version",
    "prebuild:client": "npm run generate:client-version",
    "prebuild:server": "npm run generate:client-version",
    "dev": "node --env-file=.env.local ./node_modules/.bin/turbo dev --env-mode=loose",
    "dev:client": "node --env-file=.env.local ./node_modules/.bin/turbo dev --filter=client --env-mode=loose",
    "dev:server": "node --env-file=.env.local ./node_modules/.bin/turbo dev --filter=server --env-mode=loose",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node --env-file=.env.local out/server/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.0.0",
    "fallow": "^2.86.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
