{
  "name": "tour-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node --env-file=.env.local ./node_modules/.bin/turbo dev --env-mode=loose",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "turbo build",
    "build:client": "turbo build --filter=client",
    "build:server": "turbo build --filter=server",
    "test": "turbo test",
    "test:server": "npm run test -w server",
    "test:client": "npm run test -w client",
    "test:e2e": "playwright test",
    "coverage": "turbo coverage",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
