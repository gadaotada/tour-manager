NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

LOG_LEVEL=info
LOG_REPORT_ERRORS=false
LOG_REPORT_WARNINGS=false

APP_BUILD_ID=local
APP_RELEASE=

VITE_LOG_LEVEL=info
VITE_LOG_REPORT_ERRORS=false
VITE_LOG_REPORT_WARNINGS=false
VITE_APP_BUILD_ID=local
VITE_APP_RELEASE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=tour_manager
DB_CONNECT_TIMEOUT=10000
DB_WAIT_FOR_CONNECTIONS=true
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

SESSION_SECRET=development-session-secret-change-before-production
SESSION_COOKIE_NAME=tour_manager.sid
SESSION_TTL_DAYS=7
